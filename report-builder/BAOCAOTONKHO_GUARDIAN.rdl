  <DataSources>
    <DataSource Name="KetNoiSQL">
      <rd:SecurityType>Integrated</rd:SecurityType>
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=.\SQLEXPRESS;Initial Catalog=QuanLyGuardian</ConnectString>
        <IntegratedSecurity>true</IntegratedSecurity>
      </ConnectionProperties>
      <rd:DataSourceID>98e6da80-cdd1-4c8d-92ed-aca3b42d22fa</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DuLieuTonKho">
      <Query>
        <DataSourceName>KetNoiSQL</DataSourceName>
        <CommandText>SELECT 
   
l.TenLoai,
    
sp.MaSP, 
    
sp.TenSP, 
    
sp.DonViTinh,
    
SUM(lh.SoLuongTon) AS TongTonKho

FROM SANPHAM sp

JOIN LOAISANPHAM l ON sp.MaLoai = l.MaLoai
JOIN LOHANG lh ON sp.MaSP = lh.MaSP

GROUP BY l.TenLoai, sp.MaSP, sp.TenSP, sp.DonViTinh

HAVING SUM(lh.SoLuongTon) &gt; 0</CommandText>
      </Query>
      <Fields>
        <Field Name="TenLoai">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>TenLoai</DataField>
        </Field>
        <Field Name="MaSP">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>MaSP</DataField>
        </Field>
        <Field Name="TenSP">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>TenSP</DataField>
        </Field>
        <Field Name="DonViTinh">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>DonViTinh</DataField>
        </Field>
        <Field Name="TongTonKho">
          <rd:TypeName>System.Int32</rd:TypeName>
          <DataField>TongTonKho</DataField>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
